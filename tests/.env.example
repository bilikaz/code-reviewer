# LLM credentials used by `npm test`. Required.
# Copy to tests/.env (gitignored) and fill in.
LLM_URL=https://<your_ip_or_domain>/v1
LLM_KEY=sk-...
# Optional. Cheaper model recommended for test runs.
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# VCS tokens. Only needed for tests that hit a real PR; mock:// scenarios
# don't require any.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# BITBUCKET_TOKEN=

# Tuning. Defaults shown.
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_HEAL_RETRIES=2
