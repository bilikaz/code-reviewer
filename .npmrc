# Refuse to install any package version younger than 30 days. Mitigates the
# class of supply-chain compromises where a hijacked maintainer pushes a
# malicious patch release; the bad version is typically pulled within
# hours/days of being noticed, so a 30-day quarantine almost always catches
# it before it lands in our builds. Honored natively by pnpm (>=10).
minimum-release-age=43200
minimum-release-age-exclude=
