# LLM credentials. Required.
LLM_URL=https://api.anthropic.com/v1
LLM_KEY=sk-...
# Optional. Auto-detected from /models if omitted.
LLM_MODEL=

# VCS tokens. Only the provider matching your PR URL is required.
GITHUB_TOKEN=
# GITLAB_TOKEN=
# BITBUCKET_TOKEN=

# Tuning. Defaults shown.
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_HEAL_RETRIES=2
